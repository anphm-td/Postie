# ----------------------------------------------------------------------------
# Postie POS - .gitignore
# ----------------------------------------------------------------------------

# ---- Database (SQLite) ----
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# ---- Environment / secrets ----
.env
.env.local
.env.*.local
*.pem
*.key

# ---- Node.js ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Build / output ----
dist/
build/
out/
out-electron/
dist-electron/
release/
*.tsbuildinfo
.next/
.cache/

# ---- Logs ----
logs/
*.log

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Backups ----
*.bak
*.backup
*.tmp
*.vs