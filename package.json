{
  "name": "postie-pos",
  "version": "0.1.0",
  "description": "Postie POS - Offline retail point-of-sale desktop app",
  "main": "out/main/index.js",
  "author": "An",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "echo 'Postie: skipping electron-rebuild (better-sqlite3 prebuilt for Node; rebuild only needed for Electron runtime at package time)'",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "db:init": "electron . --init-db",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "tailwind-animate": "^0.2.10",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.2",
    "electron": "^33.4.1",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
