# ----------------------------------------------------------------------------
# Postie POS - environment template
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is gitignored and never
# committed. None of these are required for local development — defaults are
# applied in code.
# ----------------------------------------------------------------------------

# Path to the SQLite database file. If unset, defaults to:
#   - ./postie.db in development
#   - <userData>/postie.db in production (per-user app data dir)
# POSTIE_DB_PATH=

# bcrypt cost factor for password hashing (higher = slower but safer).
# Default: 10
# BCRYPT_ROUNDS=10

